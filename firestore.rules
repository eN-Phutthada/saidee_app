rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if current user is an authenticated admin
    function isAdmin() {
      return request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Admins collection: strictly protected, only authenticated admins can access
    match /admins/{adminId} {
      allow read, get, list: if true;
      allow write: if request.auth != null && (request.auth.uid == adminId || isAdmin());

      // Notifications subcollection for admins
      match /notifications/{notificationId} {
        allow read, update, delete: if request.auth != null && (request.auth.uid == adminId || isAdmin());
        allow create: if request.auth != null;
      }

      match /{subcollection=**} {
        allow read, write: if isAdmin();
      }
    }

    // Users collection: public read profiles, users can edit their own, admins can manage all
    // Authenticated users can update walletBalance (for Escrow release & order refunds) or report counter fields
    match /users/{userId} {
      allow read: if true;
      allow create: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow delete: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow update: if request.auth != null && (
        request.auth.uid == userId || 
        isAdmin() ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['walletBalance']) ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uniqueReportCount', 'isFlaggedForReview', 'lastReportedAt'])
      );
      
      // Notifications subcollection: recipient or admin can read/update/delete, any authenticated user can create/send
      match /notifications/{notificationId} {
        allow read, update, delete: if request.auth != null && (request.auth.uid == userId || isAdmin());
        allow create: if request.auth != null;
      }
      
      match /{subcollection=**} {
        allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
      }
    }
    
    // Products collection: public read, write restricted to product owner (seller) or admin
    // Authenticated users can update interaction fields (likesCount, likedUsers, views) or mark status between 'sold' and 'active' (purchase/cancellation)
    match /products/{productId} {
      allow read: if true;
      allow create: if request.auth != null && (request.resource.data.sellerId == request.auth.uid || isAdmin());
      allow update: if request.auth != null && (
        resource.data.sellerId == request.auth.uid || 
        isAdmin() ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount', 'likedUsers', 'views']) ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) && request.resource.data.status in ['sold', 'active'])
      );
      allow delete: if request.auth != null && (
        resource.data.sellerId == request.auth.uid || isAdmin()
      );
    }
    
    // Orders collection: authenticated read, buyer/seller/admin write
    match /orders/{orderId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null && (
        resource.data.buyerId == request.auth.uid || 
        resource.data.sellerId == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }
    
    // Chats collection: restricted to participants in the users array or admin
    match /chats/{chatId} {
      allow read, update, delete: if request.auth != null && (
        request.auth.uid in resource.data.users || isAdmin()
      );
      allow create: if request.auth != null && (
        request.auth.uid in request.resource.data.users || isAdmin()
      );
      
      match /messages/{messageId} {
        allow read: if request.auth != null && (
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.users || isAdmin()
        );
        allow create: if request.auth != null && (
          request.resource.data.senderId == request.auth.uid || isAdmin()
        );
        allow update, delete: if request.auth != null && (
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.users || isAdmin()
        );
      }
    }

    // Master data (categories, types, etc.): Public read, Admin write
    match /categories/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /types/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /master_data/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /announcements/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /coupons/{docId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Password resets: Strictly server-side only via Cloud Functions (Zero-Trust)
    match /password_resets/{docId} {
      allow read, write: if false;
    }

    // Reviews collection: public read, authenticated users can create, owners/admin can update/delete
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && (
        resource.data.buyerId == request.auth.uid || 
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
    }

    // Shipping collection: public read, authenticated users can configure
    match /shipping/{shippingId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Transactions collection: authenticated users can read and create, 
    // owners and admins can update, admins can delete
    match /transactions/{transactionId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null && (
        resource.data.uid == request.auth.uid || 
        resource.data.userId == request.auth.uid || 
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // Notifications collection: authenticated users can read and receive notifications
    match /notifications/{notificationId} {
      allow read, write: if request.auth != null;
    }

    // Reports & Feedbacks: authenticated users can create and read, admins can manage
    match /reports/{reportId} {
      allow create, read: if request.auth != null;
      allow update, delete: if isAdmin();
    }
    match /feedbacks/{feedbackId} {
      allow create: if request.auth != null;
      allow read, update, delete: if isAdmin();
    }
    match /login_history/{historyId} {
      allow read: if isAdmin();
      allow create: if request.auth != null;
    }

    // Stores collection: public read, store owner or admin write/delete
    match /stores/{storeId} {
      allow read: if true;
      allow write: if request.auth != null && (request.auth.uid == storeId || isAdmin());
    }

    // Default deny all unmatched documents
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

