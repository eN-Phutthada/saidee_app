rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Admins collection: strictly protected, only authenticated admins can access
    match /admins/{adminId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Users collection: users can read profiles, but can only edit their own document and subcollections
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update, delete: if request.auth != null && (
        request.auth.uid == userId || exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
      
      match /{subcollection=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // Products collection: public read, write restricted to product owner (seller) or admin
    match /products/{productId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.sellerId == request.auth.uid;
      allow update, delete: if request.auth != null && (
        resource.data.sellerId == request.auth.uid || exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }
    
    // Orders collection: restricted to buyer and seller
    match /orders/{orderId} {
      allow read: if request.auth != null && (
        resource.data.buyerId == request.auth.uid || 
        resource.data.sellerId == request.auth.uid ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
      allow create: if request.auth != null && request.resource.data.buyerId == request.auth.uid;
      allow update: if request.auth != null && (
        resource.data.buyerId == request.auth.uid || 
        resource.data.sellerId == request.auth.uid ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
      allow delete: if false;
    }
    
    // Chats collection: restricted to participants in the users array
    match /chats/{chatId} {
      allow read, update, delete: if request.auth != null && (
        request.auth.uid in resource.data.users
      );
      allow create: if request.auth != null && (
        request.auth.uid in request.resource.data.users
      );
      
      match /messages/{messageId} {
        allow read: if request.auth != null && (
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.users
        );
        allow create: if request.auth != null && (
          request.resource.data.senderId == request.auth.uid
        );
      }
    }

    // Master data & System settings: Public read, Admin write
    match /master_data/{docId} {
      allow read: if true;
      allow write: if request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    match /announcements/{docId} {
      allow read: if true;
      allow write: if request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    match /coupons/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Default deny all unmatched documents
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
